# =============================================================================
# APEX-SMC secrets — copy to .env and fill in.  NEVER commit .env.
#   cp .env.example .env && chmod 600 .env
# =============================================================================

# --- OANDA v20 (required for live/practice execution) ------------------------
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=

# --- Telegram (signal broadcast + /approve, /status commands) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (optional broadcast) -------------------------------------------
DISCORD_WEBHOOK_URL=

# --- Twelve Data (secondary free feed fallback) ------------------------------
TWELVE_DATA_API_KEY=

# --- MetaTrader 5 (tertiary feed, Windows/host install only) -----------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Email alerts (optional) -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=you@example.com

# --- Operational switches (optional; also settable in config.yaml) -----------
# APEX_CONFIG=config.yaml
# APEX_EXECUTION_MODE=SEMI_AUTO
# APEX_ALLOW_LIVE=false
